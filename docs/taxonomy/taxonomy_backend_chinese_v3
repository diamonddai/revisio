## 7. 规则守卫：硬约束（非提示词，代码层）
以下为**唯一硬编码规则**，其余均由提示词驱动。

```python
# rule_guard.py

class RuleGuard:
    """
    源自分类体系的硬约束。
    非概率规则，而是大模型输出必须满足的绝对约束。
    """

    # 互斥操作
    MUTUAL_EXCLUSIVE_PAIRS = [
        ("add_title", "change_title"),
        ("add_annotation", "change_annotation"),
    ]

    # 单步最大操作数
    MAX_OPERATIONS_PER_STEP = 5

    # 合法操作白名单
    VALID_OPERATIONS = {
        "data": [
            "select_data_range", "add_data_variables",
            "select_data_variables", "change_data_granularity",
            "add_time_range", "delete_source"
        ],
        "visual": [
            "change_color", "change_chart_type",
            "change_axis_scale", "simplify_axis",
            "change_aspect_ratio", "add_background"
        ],
        "text": [
            "add_title", "change_title",
            "add_annotation", "change_annotation",
            "change_legend", "add_legend"
        ]
    }

    # 合法修改幅度
    VALID_SHIFTS = ["none", "minor", "significant", "major"]

    # 合法角色
    VALID_ROLES = ["bridger", "amplifier", "extender", "adverser"]

    # 基于语料的软指引（非硬约束）
    # 注：对抗者终端倾向已写入提示词，不作为硬约束强制执行，
    # 以允许场景合理的延续。
    # 重大修改与对抗者高度相关但非唯一关联——同样通过提示词引导，而非代码阻断。

    @staticmethod
    def validate_operations(operations: list[dict]) -> tuple[bool, list[str]]:
        errors = []

        # 数量校验
        if len(operations) > RuleGuard.MAX_OPERATIONS_PER_STEP:
            errors.append(
                f"操作过多：{len(operations)} > {RuleGuard.MAX_OPERATIONS_PER_STEP}"
            )

        # 合法性校验
        all_valid = [
            op for layer_ops in RuleGuard.VALID_OPERATIONS.values()
            for op in layer_ops
        ]
        op_names = [o["operation"] for o in operations]
        for name in op_names:
            if name not in all_valid:
                errors.append(f"未知操作：{name}")

        # 互斥校验
        for a, b in RuleGuard.MUTUAL_EXCLUSIVE_PAIRS:
            if a in op_names and b in op_names:
                errors.append(f"互斥操作：{a} 与 {b}")

        return (len(errors) == 0, errors)

    @staticmethod
    def validate_shift(magnitude: str) -> tuple[bool, list[str]]:
        errors = []
        if magnitude not in RuleGuard.VALID_SHIFTS:
            errors.append(f"非法修改幅度：{magnitude}")
        # 注：重大修改需对抗者已不再是硬约束。
        # 改为通过提示词语句引导，允许大模型推理非对抗者产生接近重大修改的边界场景。
        return (len(errors) == 0, errors)

    @staticmethod
    def validate_role(role: str) -> bool:
        return role in RuleGuard.VALID_ROLES
```

