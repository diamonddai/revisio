## 7. RuleGuard：硬约束（代码级，非 Prompt）

以下是**唯一需要硬编码的规则**，其余一切由 Prompt 驱动。

```python
# rule_guard.py

class RuleGuard:
    """
    来自 Taxonomy 的硬约束。
    这些不是概率性的——它们是 LLM 输出必须满足的绝对规则。
    """

    # 互斥操作对
    MUTUAL_EXCLUSIVE_PAIRS = [
        ("add_title", "change_title"),
        ("add_annotation", "change_annotation"),
    ]

    # 每步最大操作数
    MAX_OPERATIONS_PER_STEP = 5

    # 合法操作白名单
    VALID_OPERATIONS = {
        "data": [
            "select_data_range",       # 选择数据范围
            "add_data_variables",      # 添加数据变量
            "select_data_variables",   # 选择数据变量
            "change_data_granularity", # 改变数据粒度
            "add_time_range",          # 扩展时间范围
            "delete_source",           # 删除来源
        ],
        "visual": [
            "change_color",            # 改变颜色
            "change_chart_type",       # 改变图表类型
            "change_axis_scale",       # 改变坐标轴比例
            "simplify_axis",           # 简化坐标轴
            "change_aspect_ratio",     # 改变纵横比
            "add_background",          # 添加背景
        ],
        "text": [
            "add_title",               # 添加标题
            "change_title",            # 修改标题
            "add_annotation",          # 添加注释
            "change_annotation",       # 修改注释
        ]
    }

    # 合法偏移程度
    VALID_SHIFTS = ["none", "minor", "significant", "major"]

    # 合法角色
    VALID_ROLES = ["bridger", "amplifier", "extensioner", "adverser"]

    @staticmethod
    def validate_operations(operations: list[dict]) -> tuple[bool, list[str]]:
        """校验操作列表是否满足硬约束"""
        errors = []

        # 检查数量上限
        if len(operations) > RuleGuard.MAX_OPERATIONS_PER_STEP:
            errors.append(
                f"操作数量超限：{len(operations)} > {RuleGuard.MAX_OPERATIONS_PER_STEP}"
            )

        # 检查操作合法性
        all_valid = [
            op for layer_ops in RuleGuard.VALID_OPERATIONS.values()
            for op in layer_ops
        ]
        op_names = [o["operation"] for o in operations]
        for name in op_names:
            if name not in all_valid:
                errors.append(f"未知操作：{name}")

        # 检查互斥约束
        for a, b in RuleGuard.MUTUAL_EXCLUSIVE_PAIRS:
            if a in op_names and b in op_names:
                errors.append(f"互斥冲突：{a} 和 {b} 不能同时出现")

        return (len(errors) == 0, errors)

    @staticmethod
    def validate_shift(magnitude: str) -> bool:
        """校验偏移程度是否合法"""
        return magnitude in RuleGuard.VALID_SHIFTS

    @staticmethod
    def validate_role(role: str) -> bool:
        """校验角色是否合法"""
        return role in RuleGuard.VALID_ROLES
```

