## 7. RuleGuard: Hard Constraints (Non-Prompt, Code-Level)

These are the ONLY hard-coded rules. Everything else is prompt-driven.

```python
# rule_guard.py

class RuleGuard:
    """
    Hard constraints derived from taxonomy.
    These are NOT probabilistic — they are absolute rules that
    the LLM's output must satisfy.
    """

    # Mutually exclusive operations
    MUTUAL_EXCLUSIVE_PAIRS = [
        ("add_title", "change_title"),
        ("add_annotation", "change_annotation"),
    ]

    # Maximum operations per step
    MAX_OPERATIONS_PER_STEP = 5

    # Valid operations whitelist
    VALID_OPERATIONS = {
        "data": [
            "select_data_range", "add_data_variables",
            "select_data_variables", "change_data_granularity",
            "add_time_range", "delete_source"
        ],
        "visual": [
            "change_color", "change_chart_type",
            "change_axis_scale", "simplify_axis",
            "change_aspect_ratio", "add_background"
        ],
        "text": [
            "add_title", "change_title",
            "add_annotation", "change_annotation"
        ]
    }

    # Valid shift magnitudes
    VALID_SHIFTS = ["none", "minor", "significant", "major"]

    # Valid roles
    VALID_ROLES = ["bridger", "amplifier", "extensioner", "adverser"]

    @staticmethod
    def validate_operations(operations: list[dict]) -> tuple[bool, list[str]]:
        errors = []

        # Check count
        if len(operations) > RuleGuard.MAX_OPERATIONS_PER_STEP:
            errors.append(
                f"Too many operations: {len(operations)} > {RuleGuard.MAX_OPERATIONS_PER_STEP}"
            )

        # Check validity
        all_valid = [
            op for layer_ops in RuleGuard.VALID_OPERATIONS.values()
            for op in layer_ops
        ]
        op_names = [o["operation"] for o in operations]
        for name in op_names:
            if name not in all_valid:
                errors.append(f"Unknown operation: {name}")

        # Check mutual exclusion
        for a, b in RuleGuard.MUTUAL_EXCLUSIVE_PAIRS:
            if a in op_names and b in op_names:
                errors.append(f"Mutually exclusive: {a} and {b}")

        return (len(errors) == 0, errors)

    @staticmethod
    def validate_shift(magnitude: str) -> bool:
        return magnitude in RuleGuard.VALID_SHIFTS

    @staticmethod
    def validate_role(role: str) -> bool:
        return role in RuleGuard.VALID_ROLES
```

